# ─────────────────────────────────────────────────────────────
# Supabase (Project Settings → API)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client. Used to read/refresh Google tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Google Cloud OAuth2 (APIs & Services → Credentials)
# Enable: Google Calendar API, Google Drive API
# Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below.
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional: pin all uploads under one Drive folder.
GOOGLE_DRIVE_FOLDER_ID=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
